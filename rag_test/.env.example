# Gateway
PORT=8787

# PostgreSQL: 会话、消息、引用持久化
DATABASE_URL=postgres://zhisuo:zhisuo@127.0.0.1:5432/zhisuo

# 本地控制台登录
CONSOLE_USER=admin
CONSOLE_PASSWORD=admin

# 我们自己的开源文档服务：RAGFlow + PaddleOCR + BGE-M3
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=
RAGFLOW_DATASET_ID=
ES_URL=http://127.0.0.1:1200
ES_USER=elastic
ES_PASSWORD=infini_rag_flow
RAGFLOW_PARSE_TIMEOUT_MS=3600000
RAGFLOW_PDF_PART_PAGES=30

# OpenAI-compatible LLM
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_API_KEY=EMPTY
LLM_MODEL=qwen3.5-7b
LLM_TIMEOUT_MS=120000

# 单次上传上限（字节）
UPLOAD_MAX_BYTES=524288000

# 大文件索引并发度
INDEX_WORKER_CONCURRENCY=2

# Word 审核性能控制
WORD_REVIEW_PDF_EVIDENCE=false
WORD_REVIEW_MAX_PARAGRAPHS=120
WORD_REVIEW_MAX_LLM_CALLS=12
